# Database (locale: docker compose up -d)
DATABASE_URL=postgres://buckled:buckled@localhost:5432/buckled_gear

# Better Auth
# Genera con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-questo-segreto-in-locale-almeno-32-caratteri
BETTER_AUTH_URL=http://localhost:3000

# Primo redattore creato da `pnpm db:seed`
SEED_REDATTORE_EMAIL=redazione@buckled.local
SEED_REDATTORE_NAME=Redazione
SEED_REDATTORE_PASSWORD=password-temporanea

# Solo su Vercel: le mette lo store Vercel Blob collegato (accesso Public).
# Vuote in locale = foto salvate in public/products.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# Solo su Vercel / produzione
# Origini extra accettate dal login, separate da virgole (le anteprime Vercel si aggiungono da sole).
BETTER_AUTH_TRUSTED_ORIGINS=
# "on" quando la wiki diventa pubblica: abilita l'indicizzazione dei motori di ricerca.
SITE_INDEXING=
